    "@sentry/nuxt": "^11.10.0",
    "@tailwindcss/vite": "^4.3.4",
    "@takumi-rs/core": "^2.20.0",
    "@takumi-rs/wasm": "^2.20.0",
    "ical-generator": "^11.1.3",
    "lodash": "^4.18.1",
    "lucide-vue-next": "^1.0.0",
    "mapbox-gl": "^3.34.1",
    "nuxt": "^4.6.4",
    "nuxt-security": "^2.7.0",
    "posthog-js": "^1.444.4",
    "tiny-cookie": "^2.5.1",
    "vue": "latest",
    "vue-router": "latest",
    "vue-select": "^4.0.0-beta.6",
    "vue-tsc": "^3.3.14"
